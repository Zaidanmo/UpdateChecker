<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- A repository-local cache prevents an existing global cache entry from
         bypassing package source mapping during restore. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>

  <packageSources>
    <!-- Do not inherit unreviewed package feeds from a developer machine. -->
    <clear />
    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json"
         protocolVersion="3" />
  </packageSources>

  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>

  <packageSourceMapping>
    <!-- New direct or transitive package IDs must be reviewed and explicitly
         added here before NuGet is allowed to download them. -->
    <packageSource key="nuget.org">
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="Microsoft.TestPlatform.ObjectModel" />
      <package pattern="Microsoft.TestPlatform.TestHost" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="xunit" />
      <package pattern="xunit.abstractions" />
      <package pattern="xunit.analyzers" />
      <package pattern="xunit.assert" />
      <package pattern="xunit.core" />
      <package pattern="xunit.extensibility.core" />
      <package pattern="xunit.extensibility.execution" />
      <package pattern="xunit.runner.visualstudio" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<Window x:Class="UpdateChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Update Checker"
        Icon="Assets/app_logo.ico"
        Width="1040"
        Height="680"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F6FED"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#245FD6"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E4FB8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EC"/>
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#EDF4FF"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#9EADC2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#6B778C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#E8EDF3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7F9FC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoftBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FBFCFE"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="34,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="App Update Checker"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Keep your installed applications current and secure."
                               Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <Button x:Name="CheckUpdatesButton"
                        Grid.Column="1"
                        Content="Check for updates"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CheckUpdatesButton_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="34,26,34,30">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Color="#24344D"
                                      Opacity="0.08"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Available updates"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Newer versions detected through WinGet"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Grid x:Name="LoadingProgressBar"
                                  Width="26"
                                  Height="26"
                                  Margin="0,0,12,0"
                                  Visibility="Collapsed"
                                  RenderTransformOrigin="0.5,0.5"
                                  UseLayoutRounding="True">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="Visibility" Value="Visible">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinnerAnimation">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.8"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinnerAnimation"/>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Ellipse Stroke="#D7E0EB" StrokeThickness="3"/>
                                <Path Data="M 13,2 A 11,11 0 0 1 24,13"
                                      Stroke="{StaticResource PrimaryBrush}"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Grid>

                            <Border Background="#FFF7D6"
                                    BorderBrush="#F0D77A"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="10,6"
                                    ToolTip="Minor and patch-level version changes">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,7,0"
                                             Fill="#D99A00"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Update available"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#805A00"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="8,0,0,0"
                                    Background="#FDEBEC"
                                    BorderBrush="#F1C4C8"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="10,6"
                                    ToolTip="The first numeric version component has changed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,7,0"
                                             Fill="#D64550"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Major update"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#982E37"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}"/>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="UpdatesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  ColumnHeaderHeight="48"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="White"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  SnapsToDevicePixels="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="APPLICATION"
                                                        SortMemberPath="Name"
                                                        Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="22,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Id}"
                                                           Margin="0,3,0,0"
                                                           FontSize="11.5"
                                                           Foreground="#8490A3"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="CURRENT VERSION"
                                                        SortMemberPath="InstalledVersion"
                                                        Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InstalledVersion}"
                                                       Margin="22,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Foreground="#596579"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="LATEST VERSION"
                                                        SortMemberPath="AvailableVersion"
                                                        Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SoftBlueBrush}"
                                                    BorderBrush="#D9E7FF"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="10,5"
                                                    Margin="22,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AvailableVersion}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="STATUS"
                                                        SortMemberPath="IsMajorUpdate"
                                                        Width="1.25*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Margin="22,0"
                                                    Padding="9,5"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="#FFF7D6"/>
                                                        <Setter Property="BorderBrush"
                                                                Value="#F0D77A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMajorUpdate}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#FDEBEC"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="#F1C4C8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Margin="0,0,7,0"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill"
                                                                        Value="#D99A00"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMajorUpdate}"
                                                                                 Value="True">
                                                                        <Setter Property="Fill"
                                                                                Value="#D64550"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>

                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text"
                                                                        Value="Update available"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#805A00"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMajorUpdate}"
                                                                                 Value="True">
                                                                        <Setter Property="Text"
                                                                                Value="Major update"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="#982E37"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="EmptyStatePanel"
                                Background="White"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="48"
                                        Height="48"
                                        Margin="0,0,0,14"
                                        Background="{StaticResource SoftBlueBrush}"
                                        CornerRadius="24">
                                    <StackPanel Width="20" VerticalAlignment="Center">
                                        <Rectangle Height="2"
                                                   Margin="0,0,0,4"
                                                   Fill="{StaticResource PrimaryBrush}"
                                                   RadiusX="1"
                                                   RadiusY="1"/>
                                        <Rectangle Height="2"
                                                   Margin="0,0,0,4"
                                                   Fill="{StaticResource PrimaryBrush}"
                                                   Opacity="0.75"
                                                   RadiusX="1"
                                                   RadiusY="1"/>
                                        <Rectangle Height="2"
                                                   Fill="{StaticResource PrimaryBrush}"
                                                   Opacity="0.5"
                                                   RadiusX="1"
                                                   RadiusY="1"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Nothing to show yet"
                                           HorizontalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Run an update check to find newer app versions."
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            Padding="20,12"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,15,15">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,9,0"
                                     Fill="{StaticResource PrimaryBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusTextBlock"
                                       Text="Ready to check for updates."
                                       FontSize="12.5"
                                       Foreground="#596579"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

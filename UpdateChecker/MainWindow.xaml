<Window x:Class="UpdateChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Update Checker"
        Icon="Assets/app_logo.ico"
        Width="1040"
        Height="680"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F6"
        FontFamily="Segoe UI">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FBFCFE"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="34,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="App Update Checker"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Keep your installed applications up-to-date and secure."
                               Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <Button x:Name="CheckUpdatesButton"
                        Grid.Column="1"
                        Content="Check for updates"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CheckUpdatesButton_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="34,26,34,30">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Color="#24344D"
                                      Opacity="0.08"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Available updates"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Newer versions detected through WinGet"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Grid x:Name="LoadingSpinner"
                                  Width="26"
                                  Height="26"
                                  Margin="0,0,12,0"
                                  Visibility="Collapsed"
                                  RenderTransformOrigin="0.5,0.5"
                                  UseLayoutRounding="True">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="Visibility" Value="Visible">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinnerAnimation">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.8"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinnerAnimation"/>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Ellipse Stroke="#D7E0EB" StrokeThickness="3"/>
                                <Path Data="M 13,2 A 11,11 0 0 1 24,13"
                                      Stroke="{StaticResource PrimaryBrush}"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Grid>

                            <Border Background="{StaticResource UpdateBackgroundBrush}"
                                    BorderBrush="{StaticResource UpdateBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="10,6"
                                    ToolTip="Minor and patch-level version changes">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,7,0"
                                             Fill="{StaticResource UpdateIndicatorBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Update available"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource UpdateTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="8,0,0,0"
                                    Background="{StaticResource MajorVersionBackgroundBrush}"
                                    BorderBrush="{StaticResource MajorVersionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="10,6"
                                    ToolTip="The first numeric version component has changed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,7,0"
                                             Fill="{StaticResource MajorVersionIndicatorBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Major version change"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MajorVersionTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}"/>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="UpdatesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  ColumnHeaderHeight="48"
                                  BorderThickness="0"
                                  Background="White"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLength="1,1"
                                  VirtualizingPanel.CacheLengthUnit="Page"
                                  SnapsToDevicePixels="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="APPLICATION"
                                                        SortMemberPath="Name"
                                                        Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="22,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Id}"
                                                           Margin="0,3,0,0"
                                                           FontSize="11.5"
                                                           Foreground="#8490A3"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="CURRENT VERSION"
                                                        SortMemberPath="InstalledVersion"
                                                        Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InstalledVersion}"
                                                       Margin="22,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Foreground="#596579"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="LATEST VERSION"
                                                        SortMemberPath="AvailableVersion"
                                                        Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SoftBlueBrush}"
                                                    BorderBrush="#D9E7FF"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="10,5"
                                                    Margin="22,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AvailableVersion}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="STATUS"
                                                        SortMemberPath="HasMajorVersionChange"
                                                        Width="1.25*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                             <Border Margin="22,0"
                                                    Padding="9,5"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource StatusBadgeBorderStyle}">

                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Margin="0,0,7,0"
                                                             VerticalAlignment="Center"
                                                             Style="{StaticResource StatusBadgeIndicatorStyle}"/>

                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Style="{StaticResource StatusBadgeTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="EmptyStatePanel"
                                Background="White"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="48"
                                        Height="48"
                                        Margin="0,0,0,14"
                                        Background="{StaticResource SoftBlueBrush}"
                                        CornerRadius="24">
                                    <StackPanel Width="20" VerticalAlignment="Center">
                                        <Rectangle Height="2"
                                                   Margin="0,0,0,4"
                                                   Fill="{StaticResource PrimaryBrush}"
                                                   RadiusX="1"
                                                   RadiusY="1"/>
                                        <Rectangle Height="2"
                                                   Margin="0,0,0,4"
                                                   Fill="{StaticResource PrimaryBrush}"
                                                   Opacity="0.75"
                                                   RadiusX="1"
                                                   RadiusY="1"/>
                                        <Rectangle Height="2"
                                                   Fill="{StaticResource PrimaryBrush}"
                                                   Opacity="0.5"
                                                   RadiusX="1"
                                                   RadiusY="1"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="EmptyStateTitleTextBlock"
                                           Text="Nothing to show yet"
                                           HorizontalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="EmptyStateDescriptionTextBlock"
                                           Text="Run an update check to find newer app versions."
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            Padding="20,12"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,15,15">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusIndicator"
                                     Width="7"
                                     Height="7"
                                     Margin="0,0,9,0"
                                     Fill="{StaticResource PrimaryBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusTextBlock"
                                       Text="Ready to check for updates."
                                       FontSize="12.5"
                                       Foreground="#596579"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

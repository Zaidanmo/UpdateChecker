<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2F6FED"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#245FD6"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E4FB8"/>
    <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EC"/>
    <SolidColorBrush x:Key="SoftBlueBrush" Color="#EDF4FF"/>

    <SolidColorBrush x:Key="UpdateBackgroundBrush" Color="#FFF7D6"/>
    <SolidColorBrush x:Key="UpdateBorderBrush" Color="#F0D77A"/>
    <SolidColorBrush x:Key="UpdateIndicatorBrush" Color="#D99A00"/>
    <SolidColorBrush x:Key="UpdateTextBrush" Color="#805A00"/>
    <SolidColorBrush x:Key="MajorVersionBackgroundBrush" Color="#FDEBEC"/>
    <SolidColorBrush x:Key="MajorVersionBorderBrush" Color="#F1C4C8"/>
    <SolidColorBrush x:Key="MajorVersionIndicatorBrush" Color="#D64550"/>
    <SolidColorBrush x:Key="MajorVersionTextBrush" Color="#982E37"/>

    <SolidColorBrush x:Key="StatusReadyBrush" Color="#2F6FED"/>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#16845B"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#D99A00"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#D64550"/>
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#8490A3"/>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,11"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#9EADC2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="Foreground" Value="#6B778C"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#E8EDF3"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="MinHeight" Value="66"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F7F9FC"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SoftBlueBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernScrollThumbStyle" TargetType="Thumb">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBody"
                            Margin="3,1"
                            Background="#B8C4D3"
                            CornerRadius="3"/>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody"
                                    Property="Background"
                                    Value="#8FA2BA"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody"
                                    Property="Background"
                                    Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Margin="0,4,2,4" Background="Transparent">
                        <Border x:Name="TrackBackground"
                                Width="4"
                                Background="#ECF0F5"
                                CornerRadius="2"
                                HorizontalAlignment="Center"/>

                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              Style="{StaticResource ScrollBarPageButtonStyle}"/>
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernScrollThumbStyle}"/>
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              Style="{StaticResource ScrollBarPageButtonStyle}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TrackBackground"
                                    Property="Background"
                                    Value="#DFE6EE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UpdateBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UpdateBorderBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasMajorVersionChange}" Value="True">
                <Setter Property="Background" Value="{StaticResource MajorVersionBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MajorVersionBorderBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusBadgeIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{StaticResource UpdateIndicatorBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasMajorVersionChange}" Value="True">
                <Setter Property="Fill" Value="{StaticResource MajorVersionIndicatorBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="Update available"/>
        <Setter Property="Foreground" Value="{StaticResource UpdateTextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasMajorVersionChange}" Value="True">
                <Setter Property="Text" Value="Major version change"/>
                <Setter Property="Foreground" Value="{StaticResource MajorVersionTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

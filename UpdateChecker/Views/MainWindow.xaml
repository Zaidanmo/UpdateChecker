<Window x:Class="UpdateChecker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UpdateChecker.Views"
        Title="App Update Checker"
        Icon="/UpdateChecker;component/Assets/app_logo.ico"
        Width="1040"
        Height="680"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="34,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="App Update Checker"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Keep your installed applications up-to-date and secure."
                               Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SettingsNavigationButton"
                            Margin="0,0,12,0"
                            Style="{StaticResource CircularIconButtonStyle}"
                            Click="SettingsNavigationButton_Click"
                            ToolTip="Open settings"
                            AutomationProperties.Name="Open settings"
                            VerticalAlignment="Center">
                        <Path Width="19"
                              Height="19"
                              Stretch="Uniform"
                              Fill="{DynamicResource TextBrush}"
                              Data="M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.34 19.42,11.02 L21.54,9.37 C21.73,9.22 21.78,8.95 21.66,8.73 L19.66,5.27 C19.54,5.05 19.27,4.96 19.05,5.05 L16.56,6.05 C16.04,5.66 15.48,5.32 14.87,5.07 L14.5,2.42 C14.46,2.18 14.25,2 14,2 L10,2 C9.75,2 9.54,2.18 9.5,2.42 L9.13,5.07 C8.52,5.32 7.95,5.66 7.44,6.05 L4.95,5.05 C4.72,4.97 4.46,5.05 4.34,5.27 L2.34,8.73 C2.21,8.95 2.27,9.22 2.46,9.37 L4.58,11.02 C4.53,11.34 4.5,11.67 4.5,12 C4.5,12.33 4.53,12.66 4.58,12.98 L2.46,14.63 C2.27,14.78 2.21,15.05 2.34,15.27 L4.34,18.73 C4.46,18.95 4.73,19.04 4.95,18.95 L7.44,17.95 C7.96,18.34 8.52,18.68 9.13,18.93 L9.5,21.58 C9.54,21.82 9.75,22 10,22 L14,22 C14.25,22 14.46,21.82 14.5,21.58 L14.87,18.93 C15.48,18.68 16.05,18.34 16.56,17.95 L19.05,18.95 C19.28,19.03 19.54,18.95 19.66,18.73 L21.66,15.27 C21.78,15.05 21.73,14.78 21.54,14.63 L19.43,12.98 M12,15.5 C10.07,15.5 8.5,13.93 8.5,12 C8.5,10.07 10.07,8.5 12,8.5 C13.93,8.5 15.5,10.07 15.5,12 C15.5,13.93 13.93,15.5 12,15.5 Z"/>
                    </Button>

                    <Button x:Name="CheckUpdatesButton"
                            Content="Check for updates"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CheckUpdatesButton_Click"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="UpdatesPagePanel"
                  Margin="34,26,34,30">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Color="{DynamicResource CardShadowColor}"
                                      Opacity="0.08"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Available updates"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Newer versions detected through WinGet"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Grid x:Name="LoadingSpinner"
                                  Width="26"
                                  Height="26"
                                  Margin="0,0,12,0"
                                  Visibility="Collapsed"
                                  RenderTransformOrigin="0.5,0.5"
                                  UseLayoutRounding="True">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="Visibility" Value="Visible">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinnerAnimation">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.8"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinnerAnimation"/>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Ellipse Stroke="{DynamicResource SpinnerTrackBrush}" StrokeThickness="3"/>
                                <Path Data="M 13,2 A 11,11 0 0 1 24,13"
                                      Stroke="{DynamicResource PrimaryBrush}"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Grid>

                            <Border Background="{DynamicResource UpdateBackgroundBrush}"
                                    BorderBrush="{DynamicResource UpdateBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="10,6"
                                    ToolTip="Minor and patch-level version changes">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,7,0"
                                             Fill="{DynamicResource UpdateIndicatorBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Update available"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource UpdateTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="8,0,0,0"
                                    Background="{DynamicResource MajorVersionBackgroundBrush}"
                                    BorderBrush="{DynamicResource MajorVersionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="10,6"
                                    ToolTip="The first numeric version component has changed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,7,0"
                                             Fill="{DynamicResource MajorVersionIndicatorBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Major version change"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MajorVersionTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}"/>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="UpdatesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  ColumnHeaderHeight="48"
                                  BorderThickness="0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLength="1,1"
                                  VirtualizingPanel.CacheLengthUnit="Page"
                                  SnapsToDevicePixels="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="APPLICATION"
                                                        SortMemberPath="Name"
                                                        Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="22,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Id}"
                                                           Margin="0,3,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="CURRENT VERSION"
                                                        SortMemberPath="InstalledVersion"
                                                        Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InstalledVersion}"
                                                       Margin="22,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="LATEST VERSION"
                                                        SortMemberPath="AvailableVersion"
                                                        Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SoftBlueBrush}"
                                                    BorderBrush="{DynamicResource LatestVersionBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="10,5"
                                                    Margin="22,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AvailableVersion}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="STATUS"
                                                        SortMemberPath="HasMajorVersionChange"
                                                        Width="1.25*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                             <Border Margin="22,0"
                                                    Padding="9,5"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource StatusBadgeBorderStyle}">

                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Margin="0,0,7,0"
                                                             VerticalAlignment="Center"
                                                             Style="{StaticResource StatusBadgeIndicatorStyle}"/>

                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Style="{StaticResource StatusBadgeTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="EmptyStatePanel"
                                Background="{DynamicResource SurfaceBrush}"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="48"
                                        Height="48"
                                        Margin="0,0,0,14"
                                        Background="{DynamicResource SoftBlueBrush}"
                                        CornerRadius="24">
                                    <StackPanel Width="20" VerticalAlignment="Center">
                                        <Rectangle Height="2"
                                                   Margin="0,0,0,4"
                                                   Fill="{DynamicResource PrimaryBrush}"
                                                   RadiusX="1"
                                                   RadiusY="1"/>
                                        <Rectangle Height="2"
                                                   Margin="0,0,0,4"
                                                   Fill="{DynamicResource PrimaryBrush}"
                                                   Opacity="0.75"
                                                   RadiusX="1"
                                                   RadiusY="1"/>
                                        <Rectangle Height="2"
                                                   Fill="{DynamicResource PrimaryBrush}"
                                                   Opacity="0.5"
                                                   RadiusX="1"
                                                   RadiusY="1"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="EmptyStateTitleTextBlock"
                                           Text="Nothing to show yet"
                                           HorizontalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="EmptyStateDescriptionTextBlock"
                                           Text="Run an update check to find newer app versions."
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            Padding="20,12"
                            Background="{DynamicResource FooterBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,15,15">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusIndicator"
                                     Width="7"
                                     Height="7"
                                     Margin="0,0,9,0"
                                     Fill="{DynamicResource PrimaryBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusTextBlock"
                                       Text="Ready to check for updates."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

            <views:SettingsView x:Name="SettingsPage"
                                Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <!-- Microsoft.NET.Test.Sdk depends on the coverage package, but this
             project does not collect coverage. Keep it in the locked graph
             while preventing its build targets and native tools from loading. -->
        <PackageReference Include="Microsoft.CodeCoverage" Version="17.14.1">
            <ExcludeAssets>all</ExcludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1">
            <IncludeAssets>compile; runtime; build; buildmultitargeting; native</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit" Version="2.9.3">
            <IncludeAssets>compile; runtime; build; buildmultitargeting</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
            <IncludeAssets>compile; runtime; build; native</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\UpdateChecker\UpdateChecker.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\UpdateChecker\Themes\LightTheme.xaml"
              Link="Themes\LightTheme.xaml"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\UpdateChecker\Themes\DarkTheme.xaml"
              Link="Themes\DarkTheme.xaml"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\UpdateChecker\Themes\Controls.xaml"
              Link="Themes\Controls.xaml"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\UpdateChecker\Views\MainWindow.xaml"
              Link="Views\MainWindow.xaml"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\UpdateChecker\Views\SettingsView.xaml"
              Link="Views\SettingsView.xaml"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
